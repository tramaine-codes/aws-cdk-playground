{
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "bin": {
    "aws-cdk-playground": "bin/aws-cdk-playground.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "aws-cdk": "2.1148.0",
    "del-cli": "8.0.1",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "release-it": "21.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1166.0",
    "@aws-sdk/client-ec2": "3.1166.0",
    "@aws-sdk/client-s3": "3.1166.0",
    "@aws-sdk/credential-provider-node": "3.972.96",
    "@aws-sdk/lib-dynamodb": "3.1166.0",
    "@opensearch-project/opensearch": "3.10.0",
    "@sindresorhus/is": "8.1.0",
    "aws-cdk-lib": "2.276.0",
    "constructs": "10.8.1",
    "date-fns": "4.4.0",
    "dotenv": "18.0.10",
    "effect": "4.1.3",
    "env-var": "7.5.0",
    "got": "16.2.0",
    "nanoid": "6.0.2",
    "package-directory": "8.2.0",
    "remeda": "2.59.0"
  },
  "name": "aws-cdk-playground",
  "scripts": {
    "build": "tsc",
    "cdk": "cdk",
    "clean": "del-cli lib coverage",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "release-it --ci",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "watch": "tsc -w"
  },
  "type": "module",
  "version": "0.1.0"
}
