  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "aws-cdk": "2.1148.0",
    "del-cli": "8.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "release-it": "21.1.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1164.0",
    "@aws-sdk/client-ec2": "3.1164.0",
    "@aws-sdk/client-s3": "3.1164.0",
    "@aws-sdk/credential-provider-node": "3.972.94",
    "@aws-sdk/lib-dynamodb": "3.1164.0",
    "@opensearch-project/opensearch": "3.9.0",
    "@sindresorhus/is": "8.1.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "date-fns": "4.4.0",
    "dotenv": "18.0.9",
    "effect": "4.1.2",
    "env-var": "7.5.0",
    "got": "16.2.0",
